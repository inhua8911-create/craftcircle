# Copy to server/.env and fill in. Placeholders only: never commit real values.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/craftcircle?replicaSet=rs0   # must be a replica set (transactions)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN_HOURS=168
CLIENT_ORIGIN=http://localhost:5173
# COOKIE_SECURE=true            # defaults to true in production

# Payments: "mock" is a clearly-labelled simulation that moves NO money.
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email: unset = in-app notifications only; emails are NOT sent and are reported as "not_configured".
RESEND_API_KEY=
EMAIL_FROM=

CLOUDINARY_URL=

# One-time admin bootstrap (npm run bootstrap-admin). Remove after use.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Local/e2e only: turns OFF login/registration/reset rate limits. The server refuses to start with this set in production.
# DISABLE_RATE_LIMIT=true
# Set to true to stop the in-process background jobs (reservation expiry, earnings eligibility).
# DISABLE_JOBS=true

# ---- Easy project deployment (see DEPLOY.md) ----
# DEMO_MODE=true  -> one service, no payment/email/image accounts needed: simulated checkout allowed in production,
#                    images stored in MongoDB, sample data + admin created automatically on first start.
#                    For a portfolio/demo only. Never use it for a real store.
# DEMO_MODE=true
# DEMO_PASSWORD=CraftDemo2026!   # password of the sample accounts (default shown)
# PUBLIC_URL=https://your-app.onrender.com   # optional: used in sitemap.xml and robots.txt
